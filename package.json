{
  "name": "molecular-workstation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @molecular/api\" \"npm run dev --workspace @molecular/web\"",
    "dev:web": "npm run dev --workspace @molecular/web",
    "dev:api": "npm run dev --workspace @molecular/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspace @molecular/web",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0",
    "typescript": "^5.7.2"
  }
}
